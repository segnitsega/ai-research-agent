APP_ENV=development
LOG_LEVEL=INFO
API_KEY=change-me-dev-key
CORS_ORIGINS=http://localhost:3000
# Next.js / Express BFF → FastAPI (local default; in Docker/Render this is localhost)
API_BASE_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5433/research
# Defaults to Gemini; with both GOOGLE/GEMINI and XAI keys set, Gemini is tried first then Grok.
MODEL_PLANNER=google:gemini-2.5-flash
MODEL_SEARCHER=google:gemini-2.5-flash
MODEL_READER=google:gemini-2.5-flash
MODEL_CRITIC=google:gemini-2.5-flash
MODEL_WRITER=google:gemini-2.5-flash
MODEL_CURATOR=google:gemini-2.5-flash
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
EMBEDDER=hash
EMBEDDING_MODEL=hash-384
EMBEDDING_DIM=384
# fake | duckduckgo (no key) | tavily (needs TAVILY_API_KEY)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
MAX_ACTIVE_RUNS_PER_USER=2
MAX_CONCURRENT_FETCHES=5
MAX_CONCURRENT_LLM_CALLS=8
FETCH_TIMEOUT_S=15
FETCH_MAX_BYTES=2000000
SOURCE_TTL_DAYS=14
RESPECT_ROBOTS=true
SERVER_MAX_COST_USD=5.0
SERVER_MAX_FETCHES=150
SERVER_MAX_ITERATIONS=6
LOGFIRE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ALLOW_MODEL_REQUESTS=false

# --- Render (one Web Service, Dockerfile Path = Dockerfile) ---
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://...   # Render Postgres Internal URL
# CORS_ORIGINS=https://YOUR-APP.onrender.com
# API_BASE_URL=http://127.0.0.1:8000
# API_INTERNAL_URL=http://127.0.0.1:8000
# API_KEY=...                             # same process; required by the BFF
# GOOGLE_API_KEY=...                  # preferred LLM provider
# XAI_API_KEY=...                     # fallback if Gemini fails / only Grok key set
# TAVILY_API_KEY=...
# ALLOW_MODEL_REQUESTS=true
