APP_ENV=development
LOG_LEVEL=INFO
API_KEY=change-me-dev-key
CORS_ORIGINS=http://localhost:3000
# Used by the Next.js app to reach the API (local or Render public API URL)
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5433/research
MODEL_PLANNER=xai:grok-4.7
MODEL_SEARCHER=xai:grok-4.7
MODEL_READER=xai:grok-4.7
MODEL_CRITIC=xai:grok-4.7
MODEL_WRITER=xai:grok-4.7
MODEL_CURATOR=xai:grok-4.7
XAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
EMBEDDER=hash
EMBEDDING_MODEL=hash-384
EMBEDDING_DIM=384
# fake | duckduckgo (no key) | tavily (needs TAVILY_API_KEY)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
MAX_ACTIVE_RUNS_PER_USER=2
MAX_CONCURRENT_FETCHES=5
MAX_CONCURRENT_LLM_CALLS=8
FETCH_TIMEOUT_S=15
FETCH_MAX_BYTES=2000000
SOURCE_TTL_DAYS=14
RESPECT_ROBOTS=true
SERVER_MAX_COST_USD=5.0
SERVER_MAX_FETCHES=150
SERVER_MAX_ITERATIONS=6
LOGFIRE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ALLOW_MODEL_REQUESTS=false

# --- Render (set on each service; do not commit real secrets) ---
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://...   # API only; use Render Internal URL
# CORS_ORIGINS=https://YOUR-WEB.onrender.com
# API_BASE_URL=https://YOUR-API.onrender.com  # Web service
