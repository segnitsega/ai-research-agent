# Web service — set Render "Dockerfile Path" to Dockerfile.web
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY apps/web /app
RUN pnpm install --frozen-lockfile && pnpm build

FROM node:22-slim
WORKDIR /app
RUN useradd --create-home appuser
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
RUN mkdir -p ./public
USER appuser
EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]
